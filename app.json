{
  "expo": {
    "name": "ALYVEN",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/alyven-app-icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E2A47",
        "foregroundImage": "./assets/images/alyven-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/alyven-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5FAF9",
          "image": "./assets/images/alyven-splash.png",
          "imageWidth": 184
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
